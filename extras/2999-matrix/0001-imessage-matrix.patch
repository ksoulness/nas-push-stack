+def _cell_imessage(key, gw_cell=None):
+    """iMessage 频道的调用方式。
+
+    与其它列一致：公式/Bearer/飞书走 3004（3004 → apprise `json://` → 网关 8098）；
+    另附 `direct` 给出 8098 直连公式（绕过 apprise，少一跳）。
+    """
+    c = dict(gw_cell or {})
+    base = IMESSAGE_URL.rstrip("/")
+    hub = HUB_URL.rstrip("/")
+    feishu = f"{hub}/feishu/{key}"
+    return {
+        "ok": True,
+        "key": key,
+        "target": c.get("target", ""),
+        "backend": c.get("backend", ""),
+        "formula": f'curl -G "{hub}/push/{key}" --data-urlencode "title=标题" '
+                   f'--data-urlencode "body=内容"',
+        "bearer": f'curl -X POST -H "Authorization: Bearer {key}" '
+                  f'-d \'{{"title":"标题","content":"内容"}}\' {hub}/api/push',
+        "apprise": f"POST http://192.168.1.10:8000/notify/{key}",
+        "feishu_pub": feishu,
+        "feishu_lan": feishu,
+        "direct": c.get("formula") or f'curl -G "{base}/push/{key}" '
+                                      f'--data-urlencode "title=标题" --data-urlencode "body=内容"',
+        "sms_hook": c.get("sms_hook") or f"POST {base}/hook/imessage (HMAC)",
+    }
+
+
+def _imessage_cells():
+    """从 iMessage 网关的 /matrix.json 取 频道→调用方式；网关离线时返回空（不阻塞 2999）。"""
+    try:
+        with urllib.request.urlopen(IMESSAGE_URL.rstrip("/") + "/matrix.json", timeout=3) as r:
+            data = json.loads(r.read().decode("utf-8"))
+    except Exception:
+        return {}
+    out = {}
+    for row in data.get("channels") or []:
+        cell = row.get("imessage") or {}
+        if cell.get("ok") and cell.get("key"):
+            out[row.get("channel") or cell["key"]] = _cell_imessage(cell["key"], cell)
+    return out
+
+

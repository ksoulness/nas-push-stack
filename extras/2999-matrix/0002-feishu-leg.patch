+# --------------------------------------------------- 飞书出站（2026-10-19）
+# apprise 没有飞书插件，出站腿只能自己做：每个频道一个 cfg 腿
+#   json://192.168.1.10:3806/feishu_<频道>
+# 端口必须用宿主 LAN IP 而不是 127.0.0.1——apprise 跑在容器里
+# （net=clash，与宿主不共享 loopback），127.0.0.1 会打到容器自己身上。
+# 端口选 3806 而非 3006：30xx 段被 docker publish 占用/争用，实测 3006-3010
+# 全被 docker-proxy 监听（2026-10-19 首轮部署因此崩过一次）。
+# apprise POST {"title":…,"message":…} 到本口，这里改投飞书 im/v1/messages。
+# 消息首行固定 "[频道: <频道>] <标题>"，满足「每条都能看出属于哪个频道」。
+_FEISHU_TOKEN = {"token": "", "exp": 0.0}
+_FEISHU_LOCK = threading.Lock()
+
+
+def _feishu_creds():
+    """读 feishu.env（逐行 KEY=VALUE）；文件缺失/不可读时返回 {}。"""
+    out = {}
+    try:
+        with open(FEISHU_CRED, encoding="utf-8") as f:
+            for line in f:
+                line = line.strip()
+                if not line or line.startswith("#") or "=" not in line:
+                    continue
+                k, v = line.split("=", 1)
+                out[k.strip()] = v.strip().strip('"').strip("'")
+    except OSError:
+        return {}
+    return out
+
+
+def _feishu_token(creds):
+    """tenant_access_token，进程内缓存，到期前 60s 刷新。"""
+    now = time.time()
+    with _FEISHU_LOCK:
+        if _FEISHU_TOKEN["token"] and _FEISHU_TOKEN["exp"] > now + 60:
+            return _FEISHU_TOKEN["token"]
+        body = json.dumps({"app_id": creds.get("FEISHU_APP_ID", ""),
+                           "app_secret": creds.get("FEISHU_APP_SECRET", "")}).encode()
+        req = urllib.request.Request(
+            FEISHU_API + "/auth/v3/tenant_access_token/internal", data=body,
+            method="POST", headers={"Content-Type": "application/json; charset=utf-8"})
+        with urllib.request.urlopen(req, timeout=10) as r:
+            d = json.loads(r.read().decode("utf-8", "replace") or "{}")
+        if d.get("code") != 0 or not d.get("tenant_access_token"):
+            raise RuntimeError(f"feishu token failed: {d.get('code')} {d.get('msg')}")
+        _FEISHU_TOKEN["token"] = d["tenant_access_token"]
+        _FEISHU_TOKEN["exp"] = now + int(d.get("expire") or 7200)
+        return _FEISHU_TOKEN["token"]
+
+
+def _feishu_text(channel, title, body):
+    """首行固定带频道名；剥掉 3004 已加的 [key] 前缀以免重复。"""
+    head = f"[频道: {channel or 'unknown'}]"
+    t = (title or "").strip()
+    m = re.match(r"^\[[^\]]{1,40}\]\s*", t)
+    if m:
+        t = t[m.end():].strip()
+    if t:
+        head += " " + t
+    body = (body or "").strip()
+    return head + (("\n" + body) if body else "")
+
+
+def _feishu_send(creds, channel, title, body):
+    chat_id = creds.get("FEISHU_CHAT_ID", "")
+    if not chat_id:
+        raise RuntimeError("feishu.env 缺 FEISHU_CHAT_ID")
+    tok = _feishu_token(creds)
+    payload = {"receive_id": chat_id, "msg_type": "text",
+               "content": json.dumps({"text": _feishu_text(channel, title, body)},
+                                     ensure_ascii=False)}
+    req = urllib.request.Request(
+        FEISHU_API + "/im/v1/messages?receive_id_type=chat_id",
+        data=json.dumps(payload, ensure_ascii=False).encode("utf-8"),
+        method="POST",
+        headers={"Content-Type": "application/json; charset=utf-8",
+                 "Authorization": f"Bearer {tok}"})
+    with urllib.request.urlopen(req, timeout=10) as r:
+        d = json.loads(r.read().decode("utf-8", "replace") or "{}")
+    if d.get("code") != 0:
+        raise RuntimeError(f"feishu send failed: {d.get('code')} {d.get('msg')}")
+    return (d.get("data") or {}).get("message_id", "")
+
+
+class FeishuOutHandler(Handler):
+    """第 5 口：apprise json:// 腿 → 飞书群消息（首行带频道名）。"""
+
+    ROLE = "feishu-out"
+
+    def _channel(self):
+        parts = [p for p in self.path.split("?")[0].split("/") if p]
+        name = parts[-1] if parts else ""
+        return name[len("feishu_"):] if name.startswith("feishu_") else name
+
+    def _feishu_out(self):
+        if self.path.split("?")[0] in ("/health", "/healthz"):
+            self._reply_json({"status": "ok"})
+            return
+        try:
+            n = int(self.headers.get("Content-Length") or 0)
+            raw = self.rfile.read(n) if n else b""
+            ct = (self.headers.get("Content-Type") or "").lower()
+            payload = {}
+            if raw:
+                if "json" in ct:
+                    payload = json.loads(raw.decode("utf-8", "replace") or "{}")
+                elif "form" in ct or not ct:
+                    payload = {k: v[0] for k, v in urllib.parse.parse_qs(
+                        raw.decode("utf-8", "replace")).items()}
+            qs = (urllib.parse.parse_qs(self.path.split("?", 1)[1])
+                  if "?" in self.path else {})
+            title = payload.get("title") or (qs.get("title") or [""])[0]
+            body = (payload.get("message") or payload.get("body")
+                    or (qs.get("body") or qs.get("content") or [""])[0])
+            if isinstance(body, (list, tuple)):
+                body = "\n".join(str(x) for x in body)
+            creds = _feishu_creds()
+            if not creds:
+                raise RuntimeError(f"缺凭据文件 {FEISHU_CRED}")
+            ch = self._channel()
+            mid = _feishu_send(creds, ch, title, str(body or ""))
+            print(f"[feishu] sent channel={ch} message_id={mid}", flush=True)
+            self._reply_json({"code": 0, "msg": "ok", "message_id": mid})
+        except Exception as e:  # 绝不挂住 apprise
+            print(f"[feishu] err {self.path}: {e}", flush=True)
+            self._reply_json({"code": 502, "msg": f"feishu error: {e}"}, 502)
+
+    do_POST = _feishu_out
+    do_GET = _feishu_out
+
+

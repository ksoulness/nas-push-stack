# imessage-gw 环境（部署后 chmod 600，owner 10001）。真实密钥由部署脚本生成，不要提交。

# ---- 监听与鉴权 ----
# 密钥生成：openssl rand -base64 32
SMS_GW_LISTEN=0.0.0.0:8099
SMS_GW_SECRET=__GENERATED__
SMS_GW_TOKEN=__GENERATED__
SMS_GW_MAX_SKEW_SEC=300

# ---- 过滤（留空=不过滤）----
SMS_ALLOW_FROM=
SMS_MAX_LEN=1200

# ---- 模板（\n 表示换行）----
MSG_TEMPLATE=【短信】{from}\n{body}\n\n收于 {received}

# ---- 重试与日志 ----
REDACT_LOGS=1
RETRY_MAX=5
RETRY_BACKOFF_SEC=5,15,60,300,900
HTTP_TIMEOUT_SEC=20

# ---- 后端 ----
IMESSAGE_BACKEND=imessaged
TARGET_HANDLE=recipient@example.com
IMSG_TIMEOUT_SEC=120
IMSG_BIN=/usr/local/bin/imsg
IMESSAGED_BUS=unix:path=/bus/bus

# ---- 推送方言（与 Apprise/2999 兼容的键名：<service>_<channel>）----
PUSH_KEYS=imessage_nas
PUSH_TEMPLATE={body}
# /matrix.json 里展示给你的调用地址用的对外主机与端口
PUBLIC_HOST=127.0.0.1
PUBLIC_PORT=8098
